# ---------------------------------------------------------------------------
# Wompi — copia este archivo como `.env.local` y llena los valores.
# `.env.local` está en .gitignore: NUNCA subas llaves reales al repositorio.
# ---------------------------------------------------------------------------

# Llave PÚBLICA de Wompi. Es la única llave que puede llegar al navegador.
# Sandbox (empieza así):    pub_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Producción (empieza así): pub_prod_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# El widget se sirve siempre desde https://checkout.wompi.co/widget.js:
# el prefijo de la llave (test/prod) es lo que decide el ambiente.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_TU_LLAVE_PUBLICA

# Secreto de INTEGRIDAD. Solo se usa en el servidor para firmar el pago.
# Sandbox:    test_integrity_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Producción: prod_integrity_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NO le pongas el prefijo NEXT_PUBLIC_: eso lo expondría en el frontend.
WOMPI_INTEGRITY_SECRET=test_integrity_TU_SECRETO_DE_INTEGRIDAD

# Página de Agradecimiento. Solo se llega ahí si Wompi confirma que la
# transacción quedó APPROVED.
NEXT_PUBLIC_THANK_YOU_URL=https://pageagradecimiento.vercel.app/

# URL pública de ESTE sitio. Se usa para armar la URL de retorno de Wompi
# (/pago/estado) cuando el pago sale de la página, como en PSE.
# Si no se define, se deduce del origen de la petición del navegador.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app

# ---------------------------------------------------------------------------
# Precio
# ---------------------------------------------------------------------------

# Precio de la oferta en CENTAVOS de dólar. 250000 = US$2,500.00
PRICE_IN_USD_CENTS=250000

# Pesos colombianos por dólar. Wompi Colombia solo cobra en COP, así que el
# precio en USD se convierte con esta tasa para generar el cargo real.
#
# ⚠️ REVÍSALA antes de cobrar de verdad y cada vez que la tasa se mueva:
# es un valor FIJO, nadie lo actualiza solo. Si está desactualizada vas a
# cobrar de más o de menos.
USD_TO_COP_RATE=4000

# (Opcional) Prefijo de la referencia de pago: VICTOR-20260825-ABC123
WOMPI_REFERENCE_PREFIX=VICTOR

# La llave PRIVADA (prv_test_... / prv_prod_...) y el secreto de EVENTOS
# no se usan en este flujo. Si más adelante se agrega un webhook de
# confirmación, van también solo en el servidor, nunca con NEXT_PUBLIC_.
